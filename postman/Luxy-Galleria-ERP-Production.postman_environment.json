{
  "name": "Luxy Galleria ERP - Production",
  "values": [
    {
      "key": "baseUrl",
      "value": "https://api.luxygalleria.com/api/v1",
      "type": "default",
      "enabled": true,
      "description": "API base, no trailing slash"
    },
    {
      "key": "erpKeyId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "ERP key id issued by Luxy Galleria (must match the server configuration exactly)"
    },
    {
      "key": "erpSecret",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "ERP secret issued by Luxy Galleria. Current value only; never commit or share."
    },
    {
      "key": "itemSku",
      "value": "ERP-TEST-SKU-001",
      "type": "default",
      "enabled": true,
      "description": "Variant SKU used by Item Add, Item Edit and Stock Update"
    },
    {
      "key": "categoryName",
      "value": "Chocolates",
      "type": "default",
      "enabled": true,
      "description": "Existing website category name for Item Add"
    },
    {
      "key": "stockQuantity",
      "value": "10",
      "type": "default",
      "enabled": true,
      "description": "Absolute quantity for Stock Update"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "24-hex website order id (copy from Order Checking). Use an approved test order for status changes."
    },
    {
      "key": "orderStatus",
      "value": "shipped",
      "type": "default",
      "enabled": true,
      "description": "processing | shipped | delivered | cancelled"
    },
    {
      "key": "trackingNumber",
      "value": "TEST-TRACK-001",
      "type": "default",
      "enabled": true,
      "description": "Tracking number sent with the status change"
    },
    {
      "key": "eventId",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "Leave empty to auto-generate a unique id per send; set a fixed value to test redelivery"
    },
    {
      "key": "imageSha256",
      "value": "",
      "type": "default",
      "enabled": true,
      "description": "SHA-256 (hex) of the file selected in Image Upload"
    }
  ],
  "_postman_variable_scope": "environment"
}
