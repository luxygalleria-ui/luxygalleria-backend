# Names only — never commit real values. Copy to .env locally; configure production values in the host's secret manager.
PORT=5000
NODE_ENV=development
# Local development: mongodb://127.0.0.1:27017/luxy-galleria. Never a production URI with write access.
MONGO_URI=
# development only: if MONGO_URI fails, fall back to local luxy-galleria (logged loudly). Off unless "true".
ALLOW_LOCAL_DB_FALLBACK=
# development refuses the production database "luxy" unless "true" (use only with a read-only user)
ALLOW_PRODUCTION_DB_IN_DEV=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=
FRONTEND_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FROM_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, local development only: show historical orders/customers on the local dashboard from a READ-ONLY login.
# Refused unless NODE_ENV=development; the login must hold no role that can write. Never a MONGO_URI replacement.
HISTORY_READ_ENABLED=
HISTORY_READ_URI=
HISTORY_READ_DB=luxy

# ERP integration (docs/ERP-INTEGRATION-API-SPEC.md)
# keyId:secret pairs, comma-separated (two entries during a rotation). Secret: 32+ random characters,
# e.g. `openssl rand -hex 32`. Use different keys for sandbox/staging and production.
ERP_API_KEYS=
