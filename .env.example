# Names only — never commit real values. Copy to .env locally; set real values in the Render dashboard.
PORT=5000
NODE_ENV=development
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=
FRONTEND_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FROM_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ERP integration (docs/ERP-INTEGRATION-API-SPEC.md)
# keyId:secret pairs, comma-separated (two entries during a rotation). Secret: 32+ random characters,
# e.g. `openssl rand -hex 32`. Use different keys for sandbox/staging and production.
ERP_API_KEYS=
