# Names only — never commit real values. Copy to .env locally; configure production values in the host's secret manager.
PORT=5000
NODE_ENV=development
# Local development: mongodb://127.0.0.1:27017/luxy-galleria. Never a production URI with write access.
MONGO_URI=
# development only: if MONGO_URI fails, fall back to local luxy-galleria (logged loudly). Off unless "true".
ALLOW_LOCAL_DB_FALLBACK=
# development refuses the production database "luxy" unless "true" (use only with a read-only user)
ALLOW_PRODUCTION_DB_IN_DEV=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=
FRONTEND_URL=https://luxygalleria.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay webhook signing secret (Dashboard -> Webhooks). Empty = POST /payments/webhook answers 503 (disabled).
RAZORPAY_WEBHOOK_SECRET=
# Minutes an unpaid checkout keeps its reserved stock (default 30, minimum 5)
CHECKOUT_SESSION_TTL_MINUTES=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
FROM_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, local development only: show historical orders/customers on the local dashboard from a READ-ONLY login.
# Refused unless NODE_ENV=development; the login must hold no role that can write. Never a MONGO_URI replacement.
HISTORY_READ_ENABLED=
HISTORY_READ_URI=
HISTORY_READ_DB=luxy

# ERP integration (docs/ERP-INTEGRATION-API-SPEC.md)
# keyId:secret pairs, comma-separated (two entries during a rotation). Secret: 32+ random characters,
# e.g. `openssl rand -hex 32`. Use different keys for sandbox/staging and production.
ERP_API_KEYS=

# ======================================================================================================================
# ICICI Orange PG (backend only; never expose ICICI_PG_SECRET_KEY to the frontend). Names are exactly what the code reads
# (src/utils/iciciPg.ts, src/controllers/iciciController.ts). UAT host pgpayuat.icicibank.com/tsp/pg/api/...,
# live host pgpay.icicibank.com/pg/api/... . Sale and command URLs must point at the SAME environment.
#
# --- MANDATORY: if any is empty, /payments/icici/initiate answers 503 and no ICICI request is made
ICICI_PG_INITIATE_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_PG_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
ICICI_PG_MERCHANT_ID=
ICICI_PG_SECRET_KEY=
# Browser form-post target after payment (max 128 chars); must reach THIS backend's /api/v1/payments/icici/callback
ICICI_PG_RETURN_URL=https://api.luxygalleria.com/api/v1/payments/icici/callback
# (also used: FRONTEND_URL above, where the callback sends the customer: /order-success or /order-failure)
#
# --- OPTIONAL (consumed when set)
# Sent with every request when set. ICICI marks it mandatory when the onboarding mail provides one (Luxy's does).
ICICI_PG_AGGREGATOR_ID=
# Default 356 (INR)
ICICI_PG_CURRENCY_CODE=356
# UAT tester gate. Unless BOTH sale and command URLs are live (https://pgpay.icicibank.com), only these accounts may pay,
# on every server except NODE_ENV exactly "development" (unset or "staging" are gated too). Comma-separated MongoDB user
# _ids (24 hex), never emails: registration does not prove email ownership. Empty = nobody; one malformed entry = nobody.
# Before listing an id, confirm it is the intended existing customer (read-only):
#   mongosh "$MONGO_URI" --quiet --eval 'db.users.find({_id: ObjectId("<id>")}, {email: 1, role: 1, isActive: 1})'
# ICICI_PG_UAT_TEST_EMAILS is NOT read for authorisation (only a "no longer used" warning is logged if it is still set).
ICICI_PG_UAT_TEST_USER_IDS=
#
# --- PROCESS-ONLY FLAG (never put it in any .env file): ICICI_PG_ALLOW_REAL_GATEWAY_IN_DEV
# With NODE_ENV=development every request to a real ICICI host (*.icicibank.com) is refused unless this is exactly "true".
# It is set only by `npm run dev:icici-uat`, which preloads the git-ignored .env.uat.local (real UAT values, same names
# as above; its values win for those keys) for that process. Plain `npm run dev` never loads .env.uat.local.
#
# --- REFERENCE ONLY (not read by the code; kept so the full ICICI configuration is in one place)
ICICI_PG_GENERATE_QR_URL=https://pgpayuat.icicibank.com/tsp/pg/api/generateQR
ICICI_PG_SETTLEMENT_DETAILS_URL=https://pgpayuat.icicibank.com/tsp/pg/api/settlementDetails
ICICI_PG_USER_CANCEL_URL=https://pgpayuat.icicibank.com/tsp/pg/api/userCancel
# Advice URLs are configured on ICICI's side at onboarding (server-to-server posts), not sent by this backend
ICICI_PG_PAYMENT_ADVICE_URL=https://api.luxygalleria.com/api/v1/payments/icici/payment-advice
ICICI_PG_SETTLEMENT_ADVICE_URL=https://api.luxygalleria.com/api/v1/payments/icici/settlement-advice
#
# --- LOCAL MOCK (npm run dev): npm run mock:icici  (scripts/icici-local-mock.js; no network, 127.0.0.1 only). In .env:
#   ICICI_PG_INITIATE_SALE_URL=http://localhost:8442/tsp/pg/api/v2/initiateSale  ICICI_PG_COMMAND_URL=http://localhost:8442/tsp/pg/api/command
#   ICICI_PG_RETURN_URL=http://localhost:8444/api/v1/payments/icici/callback    and FAKE local MERCHANT_ID / AGGREGATOR_ID / SECRET_KEY values.
#   Whole local checkout in one command (mock -> backend -> storefront, Ctrl+C stops all): npm run dev:icici-mock
#   The storefront follows the plain-http mock page only while it is itself open on localhost (no certificate warning, no setting).
# ======================================================================================================================

# Other variables the backend reads (optional)
# Google sign-in (POST /auth/google). The backend also accepts NEXT_PUBLIC_GOOGLE_CLIENT_ID as a fallback name.
GOOGLE_CLIENT_ID=
# MONGODB_URI is accepted as a fallback name for MONGO_URI. NEXT_PUBLIC_RAZORPAY_KEY_ID is a legacy fallback for
# RAZORPAY_KEY_ID. MIGRATION_MONGO_URI is read only by the one-off migrate:cloudinary-cloud script (never MONGO_URI).
